{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "acs", "args": ["hook", "claude-code"], "timeout": 20 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "acs", "args": ["hook", "claude-code"], "timeout": 20 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "acs", "args": ["hook", "claude-code"], "timeout": 30 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          { "type": "command", "command": "acs", "args": ["hook", "claude-code"], "timeout": 30 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "acs", "args": ["hook", "claude-code"], "timeout": 5 }
        ]
      }
    ]
  }
}
